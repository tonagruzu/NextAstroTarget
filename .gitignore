# NextAstroTarget .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
# Keep our build spec files
# *.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Application specific
# Database files (generated at runtime)
data/*.db
data/*.sqlite
data/*.sqlite3

# Image cache (generated at runtime)
data/image_cache/*.jpg
data/image_cache/.cache_index.json
data/image_cache/.cache_index.tmp

# Object preview images (extracted from the spreadsheet at import)
data/object_images/

# Log files (generated at runtime)
logs/*.log
logs/*.log.*

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Configuration files with sensitive data (keep template versions)
config/local_config.ini

# Excel files (these are usually large and should be provided separately)
*.xlsx
*.xlsm
# Exception: keep sample/template files if needed
# !sample_data.xlsx

# Development and testing
.coverage
htmlcov/
.pytest_cache/
test_results/

# Documentation builds
docs/_build/
docs/build/

# Packaging
*.tar.gz
*.zip
*.exe
build/
dist/

